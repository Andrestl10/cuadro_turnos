{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users/' + auth.uid + '/role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users/' + auth.uid + '/role').val() === 'admin')"
      }
    },

    "schedules": {
      "$monthKey": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'admin'"
      }
    },

    "requests": {
      "$monthKey": {
        "$requestId": {
          ".read": "auth != null && (data.child('uid').val() === auth.uid || root.child('users/' + auth.uid + '/role').val() === 'admin')",
          ".write": "auth != null && (root.child('users/' + auth.uid + '/role').val() === 'admin' || (newData.child('uid').val() === auth.uid && newData.child('status').val() === 'open'))"
        }
      }
    }
  }
}

