## Firebase (Vite)
## Copy this file to `.env.local` and fill with your Firebase values.
## Do NOT commit `.env.local`.
VITE_FIREBASE_API_KEY="YOUR_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID="YOUR_MEASUREMENT_ID"
VITE_FIREBASE_DATABASE_URL="https://gestion-turno-mes-default-rtdb.firebaseio.com"
VITE_ADMIN_EMAILS="admin@tu-dominio.com,otro-admin@tu-dominio.com"

## OpenRouter AI — optional IA schedule suggestions
# VITE_OPENROUTER_API_KEY="your-openrouter-key"
# Optional: model id (default google/gemini-2.5-flash). 
# VITE_OPENROUTER_MODEL="anthropic/claude-3-haiku"
